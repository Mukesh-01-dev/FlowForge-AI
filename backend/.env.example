# Example Environment Variables File
# Copy this file to '.env' and replace the values with your actual settings.

# Project Info
PROJECT_NAME="FlowForge-AI API"
VERSION="1.0.0"

# Application Config
# Example: "production", "development", "testing"
ENVIRONMENT="development"
# The port your FastAPI app might be set to run on
PORT=8000

# Security (Auth & JWT)
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY="YOUR_SUPER_SECRET_KEY_HERE"
# Number of minutes the access token is valid
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Example for PostgreSQL: postgresql://user:password@localhost/dbname
# Example for SQLite: sqlite:///./test.db
DATABASE_URI="sqlite:///./test.db"

# RAG / Gemini
# WARNING: NEVER commit this file or your production keys to version control.
GEMINI_API_KEY="your-gemini-api-key-here"
